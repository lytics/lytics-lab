{
  "compilerOptions": {
    "target": "es5",
    "lib": ["es2022", "dom"],
    "module": "ESNext",
    "strict": false,
    "esModuleInterop": true,
    "allowJs": true,
    "outDir": "./dist",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
